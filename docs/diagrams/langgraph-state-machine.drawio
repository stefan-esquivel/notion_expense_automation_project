<mxfile host="app.diagrams.net">
  <diagram name="Receipt workflow" id="receipt-workflow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="1600">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" value="START" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="400" y="30" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ingest" parent="1" value="INGEST&#10;Validate input; journal duplicate check; extract text" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="400" y="140" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="extract" parent="1" value="EXTRACT&#10;Parse receipt; missing/nonpositive amount fails" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="400" y="280" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scan" parent="1" value="SCAN&#10;Check required fields" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
