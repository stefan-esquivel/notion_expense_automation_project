        </mxCell>
        <mxCell id="augment" parent="1" value="AUGMENT&#10;Attempt missing-field recovery" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="60" y="560" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="enrich" parent="1" value="ENRICH&#10;LLM category or keyword fallback" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="400" y="700" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="1" value="VALIDATE&#10;Persist issues and confidence" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;">
