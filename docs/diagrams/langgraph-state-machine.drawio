          <mxGeometry x="815" y="420" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- VALIDATION TIER CALLOUT                                     -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <mxCell id="tier_box" parent="1" value="&lt;b&gt;Validation Tiers&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#FF0000&quot;&gt;&lt;b&gt;🔴 RED — blocking&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Missing vendor / date / total&lt;br&gt;• Amount ≤ 0&lt;br&gt;• Date in the future&lt;br&gt;• Invalid date format&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot;&gt;&lt;b&gt;🟡 YELLOW — advisory&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Amount &gt; $10,000&lt;br&gt;• Date before year 2000&lt;br&gt;• Items sum ≠ total (&gt;15%)&lt;br&gt;• Low enrichment confidence&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#006600&quot;&gt;&lt;b&gt;🟢 GREEN — commit unlocked&lt;/b&gt;&lt;/font&gt;&lt;br&gt;No RED + all YELLOW acknowledged" vertex="1"
          style="whiteSpace=wrap;html=1;strokeWidth=1;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;">
          <mxGeometry x="800" y="500" width="240" height="300" as="geometry" />
        </mxCell>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- SCAN & AUGMENT CALLOUT                                      -->
