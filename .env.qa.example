# QA Environment Configuration
# Copy this file to .env.qa and fill in the values

# ============================================================
# Authentication (Choose ONE method)
# ============================================================

# Method 1: OAuth (Recommended for QA - allows workspace pages)
# Run: python scripts/notion_oauth_setup.py
# NOTION_OAUTH_CLIENT_ID=your-oauth-client-id
# NOTION_OAUTH_CLIENT_SECRET=your-oauth-client-secret
# NOTION_OAUTH_ACCESS_TOKEN=  # Generated by oauth setup script

# Method 2: Internal Integration Token (Fallback)
NOTION_API_TOKEN=your_notion_api_token_here

# QA Database IDs (generated by setup script)
EXPENSE_TABLE_DATABASE_ID=
SPLIT_DETAILS_DATABASE_ID=
BALANCES_PAGE_ID=

# User Configuration (same as production)
YOUR_NAME=Person A
PARTNER_NAME=Person B
YOUR_USER_ID=your_notion_user_id
PARTNER_USER_ID=partner_notion_user_id

# Expense Configuration
DEFAULT_SPLIT_PERCENTAGE=50
EXPENSE_RELATION_PROPERTY=Split Details Table

# QA Environment Organization (choose ONE option):

# Option 1 (Recommended): Use an existing page you created
# Create a page in Notion called "QA Testing" and paste its ID here
QA_PARENT_PAGE_ID=

# Option 2: Let the script create a parent page for you
# Provide ANY existing page ID in your workspace
# The script will create "QA Testing Environment" under it
# QA_WORKSPACE_PAGE_ID=

# File Paths (can use same as production or separate)
INPUT_FOLDER=receipts/test_input
PROCESSED_FOLDER=receipts/qa_processed

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/qa_expense_automation.log