        <mxCell id="review" parent="1" value="REVIEW&#10;Corrections/overrides; acknowledgements; confirm" vertex="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#6c8ebf;fontSize=14;">
          <mxGeometry x="400" y="980" width="240" height="80" as="geometry" />
